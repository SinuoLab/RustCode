#!/usr/bin/env bash
# pre-push hook: enforce branch protection policy
#
# main branch must not receive fork-authored commits; it is an upstream mirror
# (https://gitcode.com/atomgit_atomcode/atomcode) and only accepts upstream sync.
# All development must happen on the dev branch.
#
# Install: git config core.hooksPath .githooks
# (or run: scripts/install-hooks.sh)
#
# Bypass (NOT recommended): git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ]; then
  # Fail CLOSED. Falling back to $PWD makes the `-f` checks below fail, which
  # silently skips BOTH the auto-release step AND the release artifact gate while
  # reporting only a [WARN] -- i.e. the hook passes without enforcing anything.
  # A hook that cannot locate the repo must refuse, not pass.
  echo "[ERROR] Cannot determine repository root (git rev-parse --show-toplevel failed)." >&2
  echo "        Refusing to push: the release artifact gate would be skipped." >&2
  exit 1
fi

# Slurp every ref up-front. The child processes spawned below (release-auto.sh,
# which cross-builds / commits / tags, and prepush-release-check.sh) inherit this
# stdin; if any of them reads it, the remaining ref lines are consumed and this
# while loop ends early -- silently skipping checks for every later ref. Reading
# all lines first (plus </dev/null on the children) makes each ref independent.
refs_input="$(cat)"

while IFS= read -r line; do
  [ -n "$line" ] || continue
  read -r local_ref local_sha remote_ref remote_sha <<< "$line"
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    # main is an upstream mirror: the ONLY allowed source of change is
    # upstream/main. Any commit on main that upstream does not contain is a
    # policy violation (see AGENTS.md "分支策略").
    upstream_ref="refs/remotes/upstream/main"

    if ! git rev-parse --verify --quiet "$upstream_ref" >/dev/null 2>&1; then
      echo "" >&2
      echo "[ERROR] Upstream tracking ref '$upstream_ref' is missing." >&2
      echo "        main must sync from upstream, so this check is fail-closed." >&2
      echo "" >&2
      echo "  Configure the upstream remote once, then retry:" >&2
      echo "    git remote add upstream https://gitcode.com/atomgit_atomcode/atomcode" >&2
      echo "    git fetch upstream main --no-tags" >&2
      echo "    git branch --set-upstream-to=upstream/main main" >&2
      echo "" >&2
      echo "  To bypass this check (NOT recommended): git push --no-verify" >&2
      echo "" >&2
      exit 1
    fi

    # Count commits on local main that upstream does not contain
    ahead=$(git rev-list --count "$upstream_ref".."$local_sha" 2>/dev/null || echo "0")

    # A non-numeric result (git failure, empty output) must never reach `-gt`:
    # that raises "integer expression expected" and, worse, would leave main
    # effectively unchecked. Refuse instead -- main protection is fail-closed.
    case "$ahead" in
      '' | *[!0-9]*)
        echo "[ERROR] Cannot determine how far main is ahead of upstream/main (got '$ahead')." >&2
        echo "        Refusing to push: fail-closed." >&2
        exit 1
        ;;
    esac

    if [ "$ahead" -gt 0 ]; then
      echo "" >&2
      echo "[ERROR] Branch protection violation detected." >&2
      echo "" >&2
      echo "  main branch has $ahead commit(s) not in upstream/main ($upstream_ref)." >&2
      echo "  main is an upstream mirror; merging dev into it is prohibited." >&2
      echo "  All development must happen on the dev branch." >&2
      echo "" >&2
      echo "  To fix:" >&2
      echo "    1. Move your commits to dev:" >&2
      echo "       git checkout dev && git cherry-pick <commit-sha>" >&2
      echo "    2. Push dev:" >&2
      echo "       git push origin dev" >&2
      echo "    3. Reset main to upstream:" >&2
      echo "       git fetch upstream main --no-tags" >&2
      echo "       git checkout main && git reset --hard upstream/main" >&2
      echo "       git push origin main --force   # one-off correction only" >&2
      echo "" >&2
      echo "  To bypass this check (NOT recommended): git push --no-verify" >&2
      echo "" >&2
      exit 1
    fi
  fi

  # ---- auto release (bump + build + publish + tag) ----------------------------
  # Runs BEFORE the artifact gate while we still hold the pre-push transaction.
  # Optional: disabled when RUSTCODE_AUTO_RELEASE=off. On dev with source changes
  # since the last vX.Y.Z tag it bumps the patch, cross-builds, publishes into
  # release/<version>/, commits the version+artifacts, and creates the tag that
  # build.yml's tag-triggered Release depends on. Git decides the pushed commits
  # before this hook runs, so the bump commit rides the NEXT push; the tag is
  # pushed explicitly by the script (or by the user via --follow-tags).
  #
  # NOTE: this builds, so it can take minutes and is skipped off-dev /
  # RUSTCODE_AUTO_RELEASE=off. The artifact gate below still verifies the result.
  # Only real branch updates may trigger a build. Tags (refs/tags/*) and ref
  # deletions (all-zero local_sha) must not: the artifact gate below already
  # skips deletions, and auto-release has to agree with it instead of firing a
  # full cross-build on `git push origin v6.3.0` or `git push --delete`.
  auto_release_ok=1
  case "$remote_ref" in refs/heads/*) ;; *) auto_release_ok=0 ;; esac
  case "$local_sha" in "" | 0000000000000000000000000000000000000000) auto_release_ok=0 ;; esac

  if [ "$remote_ref" != "refs/heads/main" ] && [ "$auto_release_ok" -eq 1 ] \
      && [ -f "$ROOT/scripts/release-auto.sh" ]; then
    # Failure is NON-BLOCKING by default. Releasing is a follow-up to the push,
    # not a precondition for it -- and the host running this hook frequently
    # cannot build at all (no musl/mingw cross toolchain, a 4 GiB cgroup, or a
    # machine where the release binaries come from CI anyway). Fail-closed here
    # wedged every `git push origin dev` behind a local cross-build that was
    # never going to succeed, which defeats the purpose of a tag producer that
    # is supposed to be independent of the developer's machine.
    # RUSTCODE_AUTO_RELEASE_STRICT=1 restores blocking behaviour for hosts that
    # DO build (a release machine, or CI). The artifact gate below still verifies
    # whatever actually got committed, so a skipped release cannot masquerade as
    # a good one.
    if bash "$ROOT/scripts/release-auto.sh" </dev/null; then
      :
    else
      rc=$?
      echo "" >&2
      echo "[WARN] auto-release failed (exit $rc); pushing WITHOUT a new release." >&2
      echo "       Fix the build, then re-run it explicitly:" >&2
      echo "         bash scripts/release-auto.sh" >&2
      echo "       (RUSTCODE_AUTO_RELEASE_STRICT=1 makes this failure blocking again.)" >&2
      if [ "${RUSTCODE_AUTO_RELEASE_STRICT:-0}" = "1" ]; then
        exit "$rc"
      fi
    fi
  fi

  # ---- release artifact gate -------------------------------------------------
  # Policy: what is pushed must already carry a build-passing artifact COMMITTED
  # under release/<version>/ (version read from the pushed Cargo.toml).
  #
  # dev branches only: main is an upstream mirror whose commits never carry fork
  # release artifacts -- applying the gate there would reject every upstream sync.
  #
  # This gate VERIFIES only; it never builds. A build here would block every push
  # for minutes and can OOM a small machine. Enabled by default:
  #   RUSTCODE_PREPUSH_RELEASE=off     skip the gate
  #   RUSTCODE_PREPUSH_RELEASE=strict  also require the artifact to come from
  #                                    this exact code (see the script header)
  case "$remote_ref" in
    refs/heads/main)
      # Upstream mirror: no fork release artifact is expected on it.
      ;;
    *)
      case "$local_sha" in
        "" | 0000000000000000000000000000000000000000)
          # Deleting a remote ref: there is nothing to build.
          ;;
        *)
          if [ -f "$ROOT/scripts/prepush-release-check.sh" ]; then
            if ! bash "$ROOT/scripts/prepush-release-check.sh" --sha "$local_sha" --root "$ROOT" </dev/null; then
              echo "" >&2
              echo "[ERROR] Push rejected by the release artifact gate." >&2
              exit 1
            fi
          else
            echo "[WARN] scripts/prepush-release-check.sh missing; release gate skipped." >&2
          fi
          ;;
      esac
      ;;
  esac
done <<< "$refs_input"

exit 0
